<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark-gray industrial palette. Keys must match Light.xaml exactly. See docs/UI_STYLE_GUIDE.md. -->
    <SolidColorBrush x:Key="WindowBg" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="PanelBg" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBg" Color="#242424"/>
    <SolidColorBrush x:Key="ReadOnlyBg" Color="#313131"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#646464"/>
    <SolidColorBrush x:Key="Text" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextMuted" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="ButtonBg" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#575757"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="Selection" Color="#3F6E9E"/>
    <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Alarm" Color="#D23C3C"/>
    <SolidColorBrush x:Key="AlarmText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Warning" Color="#E0A82E"/>
    <SolidColorBrush x:Key="WarningText" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Ok" Color="#5A9A5A"/>
    <SolidColorBrush x:Key="OkText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EStopBg" Color="#CC0000"/>
    <SolidColorBrush x:Key="EStopText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GridLine" Color="#4C4C4C"/>
    <Color x:Key="PlotBgColor">#1C1C1C</Color>
    <Color x:Key="PlotFgColor">#E0E0E0</Color>
    <Color x:Key="PlotGridColor">#3A3A3A</Color>
</ResourceDictionary>
