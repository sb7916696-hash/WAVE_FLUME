<Window x:Class="WaveFlume.App.Views.AlarmDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm details" Width="580" SizeToContent="Height" MinHeight="300"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Buttons sit at the bottom, under the problem and the solution. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AckButton" Content="_Acknowledge" MinWidth="110" MinHeight="30" Margin="0,0,8,0" IsDefault="True" Click="OnAcknowledge"/>
                <Button Content="_Close" MinWidth="90" MinHeight="30" IsCancel="True"/>
            </StackPanel>
        </Border>

        <Border x:Name="Header" DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource Warning}">
            <StackPanel>
                <TextBlock x:Name="PriorityText" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="WhenText" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="16,12,16,16">
            <TextBlock Text="Problem" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="RawText" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,14"/>

            <TextBlock Text="Solution" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock x:Name="SolutionText" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
